pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick
import "../core"

// mouse cursor (Bibata Modern) in the theme color, generated by bin/canvas-cursor
Singleton {
    id: root
    property string name: ""
    readonly property string fallback: "Bibata-Modern-Classic"
    readonly property string active: Config.opt.themeCursor && name !== "" ? name : fallback

    function apply() { debounce.restart() }

    Timer {
        id: debounce
        interval: 1500
        onTriggered: {
            if (!Config.opt.themeCursor) {
                setter.running = false
                setter.command = ["sh", "-c", "hyprctl setcursor \"$1\" 24 >/dev/null; gsettings set org.gnome.desktop.interface cursor-theme \"$1\" 2>/dev/null; true", "sh", root.fallback]
                setter.running = true
                return
            }
            gen.running = false
            gen.command = [Quickshell.shellDir + "/bin/canvas-cursor", String(Theme.accent)]
            gen.running = true
        }
    }

    Process {
        id: gen
        stdout: StdioCollector {
            onStreamFinished: {
                const n = text.trim()
                if (n === "") return
                root.name = n
                setter.running = false
                setter.command = ["sh", "-c", "hyprctl setcursor \"$1\" 24 >/dev/null; gsettings set org.gnome.desktop.interface cursor-theme \"$1\" 2>/dev/null; mkdir -p \"$HOME/.icons/default\"; printf '[Icon Theme]\\nInherits=%s\\n' \"$1\" > \"$HOME/.icons/default/index.theme\"", "sh", n]
                setter.running = true
            }
        }
    }

    Process { id: setter }

    Connections {
        target: Theme
        function onAccentChanged() { root.apply() }
    }

    Connections {
        target: Config.opt
        function onThemeCursorChanged() { root.apply() }
    }

    Component.onCompleted: apply()
}
